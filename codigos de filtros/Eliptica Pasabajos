# --- Análisis temporal: respuesta al escalón ---
sistema = signal.ZerosPolesGain(z, p, k)
t = np.linspace(0, 0.012, 2500)
t, y_step = signal.step(sistema, T=t)
fig2, ax5 = plt.subplots(figsize=(10, 5))
ax5.plot(t*1000, y_step, color='#d62728', linewidth=2)
ax5.axhline(1, color='gray', linestyle='--', label='Valor final = 1')
ax5.set_title('Comportamiento Temporal: Respuesta al Escalón', fontsize=14,
              fontweight='bold')
ax5.set_xlabel('Tiempo [ms]', fontsize=12)
ax5.set_ylabel('Amplitud', fontsize=12)
ax5.legend()
ax5.grid(True, linestyle='--', alpha=0.7)
fig2.tight_layout()


alpha, beta, d, gamma, KH, KL = sp.symbols('alpha beta d gamma KH KL', positive=True)
H_circ = gamma*(KH*s**2 + KL*alpha*beta) / (
    (s + gamma)*(s**2 + d*alpha*s + alpha*beta)
)
print('\n--- Función de transferencia CIRCUITAL derivada simbólicamente ---')
print(sp.factor(H_circ))

# Parámetros circuitales obtenidos de los polos y ceros
p_real = float(np.real(p[np.argmin(np.abs(np.imag(p)))]))
p_cplx = p[np.argmax(np.imag(p))]
gamma_val = -p_real
omega0_sq = float(np.abs(p_cplx)**2)
a1_val = -2 * float(p_cplx.real)
alpha_val = beta_val = np.sqrt(omega0_sq)
d_val = a1_val / alpha_val
KH_val = float(k/gamma_val)
KL_val = float(np.real(k*(abs(z[0])**2)/(gamma_val*omega0_sq)))

Rint = 10000.0
Cint = 1/(Rint*alpha_val)
Rbp = Rint/d_val
Rhp_out = Rint/KH_val
Rlp_out = Rint/KL_val
C3 = 1/(Rint*gamma_val)

print('\n--- Parámetros del circuito y valores ideales ---')
print(f'alpha = beta = {alpha_val:.6f} 1/s; d = {d_val:.9f}')
print(f'gamma = {gamma_val:.6f} 1/s; KH = {KH_val:.9f}; KL = {KL_val:.9f}')
print(f'Integradores: R = {Rint:.0f} ohm; C1 = C2 = {Cint*1e9:.6f} nF')
print(f'Sumador HP: Rf = 10 kohm, Rin(Vin) = 10 kohm, '
      f'Rin(-BP) = {Rbp/1000:.6f} kohm, Rin(LP) = 10 kohm')
print(f'Sumador salida: Rf = 10 kohm, Rin(HP) = {Rhp_out/1000:.6f} kohm, '
      f'Rin(LP) = {Rlp_out/1000:.6f} kohm')
print(f'RC primer orden (con buffer): R3 = 10 kohm, C3 = {C3*1e9:.6f} nF')

H_circ_num = sp.factor(H_circ.subs({
    alpha: alpha_val, beta: beta_val, d: d_val,
    gamma: gamma_val, KH: KH_val, KL: KL_val
}))
print('H_circuito(s) con los valores calculados:')
print(H_circ_num)

# 
fc = np.geomspace(1, 1e5, 500)
h_ideal = signal.freqs_zpk(z, p, k, worN=2*np.pi*fc)[1]
h_circuito = sp.lambdify(s, H_circ_num, 'numpy')(1j*2*np.pi*fc)
error_abs = np.max(np.abs(h_ideal - h_circuito))
print(f'Máximo error absoluto H_ideal - H_circuito: {error_abs:.3e}')

#  Análisis de sensibilidades normalizadas
# 
print('\n--- Sensibilidades simbólicas ---')
for param in [alpha, beta, d, gamma, KH, KL]:
    S = sp.factor((param/H_circ)*sp.diff(H_circ, param))
    print(f'S_{param}^H(s) = {S}')
print('Para integradores: S_R1 = S_C1 = -S_alpha; S_R2 = S_C2 = -S_beta.')
print('Para etapa RC: S_R3 = S_C3 = -S_gamma.')
print('Sensibilidad de magnitud: dGdB/d(ln x) = (20/ln 10)*Re[S_x^H(jw)].')


param_nom = {alpha:alpha_val, beta:beta_val, d:d_val,
             gamma:gamma_val, KH:KH_val, KL:KL_val}
H_fun = sp.lambdify((s, alpha, beta, d, gamma, KH, KL), H_circ, 'numpy')
print('\n--- Sensibilidades por perturbación de parámetros +/-1% ---')
for f in [500, 1000, 4000]:
    print(f'\nFrecuencia = {f} Hz')
    for param in [alpha, beta, d, gamma, KH, KL]:
        v_nom = param_nom[param]
        vals = []
        for factor in [0.99, 1.01]:
            new = param_nom.copy()
            new[param] = v_nom*factor
            hh = H_fun(1j*2*np.pi*f, *(new[x] for x in [alpha,beta,d,gamma,KH,KL]))
            vals.append(20*np.log10(np.abs(hh)))
        print(f'  {param}: -1% => {vals[0]:+.4f} dB; +1% => {vals[1]:+.4f} dB')

