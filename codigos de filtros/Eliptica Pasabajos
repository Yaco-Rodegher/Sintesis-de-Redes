ax_zoom2.semilogx(f_eval[mask2], mag_dB[mask2], linewidth=2)
ax_zoom2.axhline(-As, color='red', linestyle=':', linewidth=1.5,
                 label=f'Límite -{As} dB')
ax_zoom2.axvline(fs, color='red', linestyle='--', linewidth=1.2, label='fs = 4000 Hz')
ax_zoom2.set_title('Transición y rechazo: 1000 a 20000 Hz', fontsize=12,
                   fontweight='bold')
ax_zoom2.set_xlabel('Frecuencia [Hz]')
